# Disabled by default. Configure locally first; do not enable publicly without Jay's approval.
ENQUIRIES_ENABLED=false
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
# Server-only secret key (sb_secret_...), or legacy service_role JWT. NEVER NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
# Verified business sender, e.g. Planned by Jay <enquiries@your-verified-domain>
ENQUIRY_EMAIL_FROM=
ENQUIRY_EMAIL_TO=
# Independent random secrets, at least 32 characters each.
ENQUIRY_SECURITY_SECRET=
ENQUIRY_RETRY_SECRET=
# Non-local origins require HTTPS and BOTH approvals; leave false during this phase.
ENQUIRIES_LIVE_APPROVED=false
ENQUIRY_PRIVACY_APPROVED=false
# Optional Turnstile; configure BOTH or leave BOTH blank. Site key is public, secret is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Phase 3: separate user-session CMS access; never reuse SUPABASE_SECRET_KEY here.
# Apply CMS + Storage migrations and create the first authorised account manually first.
CMS_ENABLED=false
SUPABASE_PUBLISHABLE_KEY=
# Confirmed public website origin for canonical URLs and sitemap; APP_ORIGIN is the auth/CSRF origin.
SITE_URL=
# Keep search indexing disabled until public launch is approved.
CMS_PUBLIC_INDEXING=false
