# Public canonical origin; use localhost while testing local admin requests if needed.
SITE_URL=https://plannedbyjay.com
# Existing Supabase project. Public reads and CMS admin use the publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Existing server-only notification configuration, shared by both enquiry routes.
# Never prefix these private keys with NEXT_PUBLIC_. No secret values are supplied here.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
ENQUIRY_EMAIL_FROM=
ENQUIRY_EMAIL_TO=jay@plannedbyjay.com
# Apply 20261027_bespoke_enquiries.sql, then set true in the intended deployment.
# One activation switch; offers remain independent and keep their existing configuration.
BESPOKE_ENQUIRIES_ENABLED=false
